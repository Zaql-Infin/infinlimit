<Application x:Class="InfinLimit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:InfinLimit" 
             xmlns:controls="clr-namespace:InfinLimit.Controls"
             xmlns:media="clr-namespace:InfinLimit.Controls"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:sf="clr-namespace:WpfSnowfall"
             Startup="Application_Startup">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Windows/Assets/ControlTemplates.xaml"/>
                <ResourceDictionary Source="Windows/Assets/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Original color palette -->
            <FontFamily x:Key="Kantumruy">pack://application:,,,/Windows/Assets/KantumruyPro-Regular.ttf</FontFamily>
            <FontFamily x:Key="TitleFont">Calibri</FontFamily>
            <FontFamily x:Key="SmallTitleFont">Bahnschrift Light</FontFamily>
            <FontFamily x:Key="BigTextFont">Microsoft JhengHei UI Light</FontFamily>

            <!-- Dark Limiter color palette -->
            <Color x:Key="Accent">#6a6aff</Color>
            <Color x:Key="UiAccentColor">#6a6aff</Color>
            <SolidColorBrush x:Key="TitleColor" Color="#6a6aff"/>
            <SolidColorBrush x:Key="AccentColor" Color="#6a6aff"/>
            <SolidColorBrush x:Key="UiAccent" Color="#6a6aff"/>
            <SolidColorBrush x:Key="FancyColor" Color="#0A0A16"/>
            <SolidColorBrush x:Key="InactiveColor" Color="#18182E"/>
            <SolidColorBrush x:Key="BackColor" Color="#0D0D1A"/>
            <SolidColorBrush x:Key="LightBackColor" Color="#11112A"/>
            <SolidColorBrush x:Key="DividorColor" Color="#1E1E3C"/>

            <SolidColorBrush x:Key="Upload" Color="#E85D5D"/>
            <SolidColorBrush x:Key="Download" Color="#6a6aff"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#F0EEE8"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#8A8AAA"/>
            <SolidColorBrush x:Key="BorderColor" Color="#1E1E3C"/>
            <SolidColorBrush x:Key="BackgroundSecondary" Color="#11112A"/>

            <!-- Disconnect: network plug pulled -->
            <Geometry x:Key="DisconnectIcon">M13.41 12L19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12Z</Geometry>

            <!-- Math Converter -->
            <local:MathConverter x:Key="Math" />

            <!-- Destiny 2 Geometry Icons -->
            <!-- Close: sharp angular X -->
            <Geometry x:Key="CloseIcon">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</Geometry>
            <!-- Hide: angular chevron -->
            <Geometry x:Key="HideIcon">M7 14L12 9 17 14z</Geometry>
            <!-- Overlay: D2 reticle / ghost sight -->
            <Geometry x:Key="Overlay">M12 2L9 5H5L5 9L2 12L5 15V19H9L12 22L15 19H19V15L22 12L19 9V5H15L12 2ZM12 8A4 4 0 0 1 16 12A4 4 0 0 1 12 16A4 4 0 0 1 8 12A4 4 0 0 1 12 8ZM12 10A2 2 0 0 0 10 12A2 2 0 0 0 12 14A2 2 0 0 0 14 12A2 2 0 0 0 12 10Z</Geometry>
            <!-- Log: D2-style angular document -->
            <Geometry x:Key="LogIcon">M4 2H14L20 8V22H4V2ZM13 3.5V9H18.5L13 3.5ZM6 13H18V11H6V13ZM6 17H14V15H6V17Z</Geometry>
            <!-- Settings: D2 hexagonal gear -->
            <Geometry x:Key="SettingsIcon">M12 1L15.5 4H19V7.5L22 11V13L19 16.5V20H15.5L12 23L8.5 20H5V16.5L2 13V11L5 7.5V4H8.5L12 1ZM12 8A4 4 0 0 0 8 12A4 4 0 0 0 12 16A4 4 0 0 0 16 12A4 4 0 0 0 12 8Z</Geometry>
            <!-- AHK: D2 Guardian crest (triforce-diamond) -->
            <Geometry x:Key="AhkIcon">M12 2L16 8H22L18 13L20 20L12 16L4 20L6 13L2 8H8L12 2Z</Geometry>
            <!-- Arc: D2 Arc subclass lightning bolt -->
            <Geometry x:Key="ArcIcon">M13 2L4.5 13H11L9 22L19.5 10H13L15 2Z</Geometry>
            <!-- QuestionMark: D2 angular info diamond -->
            <Geometry x:Key="QuestionMark">M12 2L22 12L12 22L2 12L12 2ZM12 8V13M12 15V16</Geometry>
            <!-- Speaker: D2 sound/wave icon -->
            <Geometry x:Key="Speaker">M11 16.5858V7.4142C11 6.5233 9.9229 6.0771 9.2929 6.7071L7.2929 8.7071C7.1054 8.8946 6.851 9 6.5858 9H5C4.4477 9 4 9.4477 4 10V14C4 14.5523 4.4477 15 5 15H6.5858C6.851 15 7.1054 15.1054 7.2929 15.2929L9.2929 17.2929C9.9229 17.9229 11 17.4767 11 16.5858ZM14 8.5C15.7 9.7 17 11.7 17 12S15.7 14.3 14 15.5M17 5.5C20 7.3 22 9.5 22 12S20 16.7 17 18.5</Geometry>
            <!-- Pin: D2 target marker -->
            <Geometry x:Key="Pin">M12 2L15 8H20L16 12L18 19L12 15.5L6 19L8 12L4 8H9L12 2ZM12 13L9 18 12 16.5 15 18Z</Geometry>
            <!-- Console: D2-style gamepad -->
            <Geometry x:Key="ConsoleIcon">M7 6H17C18.6 6 20 7 20.8 8.4L22 11V15C22 16.1 21.1 17 20 17H4C2.9 17 2 16.1 2 15V11L3.2 8.4C4 7 5.4 6 7 6ZM10 10H8V8H6V10H4V12H6V14H8V12H10V10ZM16 9C15.4 9 15 9.4 15 10S15.4 11 16 11 17 10.6 17 10 16.6 9 16 9ZM18 11C17.4 11 17 11.4 17 12S17.4 13 18 13 19 12.6 19 12 18.6 11 18 11Z</Geometry>

            <!-- Slider Style -->
            <Style x:Key="Slider" TargetType="Slider">
                <Setter Property="Background" Value="{StaticResource InactiveColor}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="2" Height="4" VerticalAlignment="Center"/>
                                <Track Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Width="16" Height="16">
                                            <Thumb.Template>
                                                <ControlTemplate>
                                                    <Ellipse Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TransparentWindow" TargetType="Window">
                <EventSetter Event="Loaded" Handler="TransparentWindowLoaded"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="AllowsTransparency" Value="True"/>
                <Setter Property="ResizeMode" Value="NoResize"/>
                <Setter Property="WindowStyle" Value="None"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Window">
                            <Grid x:Name="mainddd" MouseDown="BorderMouseDown">
                                <Border x:Name="backg" BorderThickness="1" BorderBrush="#1E1E3A"
                                        CornerRadius="14">
                                    <Border.Background>
                                        <SolidColorBrush Color="#0D0D1A" Opacity="0.92"/>
                                    </Border.Background>
                                </Border>
                                <!-- Blue-purple top accent line -->
                                <Border VerticalAlignment="Top" Height="2" CornerRadius="14,14,0,0" Margin="1,1,1,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#6a6aff" Offset="0.3"/>
                                            <GradientStop Color="#8888ff" Offset="0.5"/>
                                            <GradientStop Color="#6a6aff" Offset="0.7"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <!-- Blue-purple corner accents -->
                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Width="14" Height="14"
                                        Margin="1,1,0,0" CornerRadius="14,0,0,0" Opacity="0.35">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#6a6aff" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Width="14" Height="14"
                                        Margin="0,1,1,0" CornerRadius="0,14,0,0" Opacity="0.35">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                            <GradientStop Color="#6a6aff" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
