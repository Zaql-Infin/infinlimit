<Window
    x:Class="InfinLimit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:InfinLimit.Controls"
    xmlns:wincontrols="clr-namespace:InfinLimit.Windows.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:InfinLimit"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Style="{StaticResource TransparentWindow}"
    SizeToContent="WidthAndHeight"
    mc:Ignorable="d">

    <Window.Resources>
        <Geometry x:Key="Pin">
            M 12.956 18.956 L 9 15 l -3.956 -3.956 a 1 1 0 0 1 0.314 -1.626 l 5.261 -2.255 a 1 1 0 0 0 0.535 -0.548 l 1.283 -3.207 a 1 1 0 0 1 1.635 -0.336 l 6.856 6.856 a 1 1 0 0 1 -0.336 1.635 l -3.207 1.283 a 1 1 0 0 0 -0.548 0.535 l -2.255 5.261 a 1 1 0 0 1 -1.626 0.314 M 8 14 L 5 18 Q 3 21 6 19 L 10 16
        </Geometry>

        <CollectionViewSource x:Key="ModulesViewSource" Source="{Binding DisplayModules}"/>

        <Style x:Key="BackgroundImageStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource BackgroundSvgPath}" />
            <Setter Property="Stretch" Value="UniformToFill" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="StrokeThickness" Value="0.1" />
        </Style>
    </Window.Resources>

    <Grid>
        <tb:TaskbarIcon x:Name="tbIcon" IconSource="Assets/appLogo.ico" Visibility="Hidden"/>

<Grid x:Name="Main" MinWidth="290">

            <!-- Hidden volume slider (kept for code compatibility) -->
            <Slider x:Name="VolumeSlider" Visibility="Hidden"
                    Style="{StaticResource Slider}"
                    Orientation="Vertical"
                    Value="0" Maximum="100" TickFrequency="1"
                    Width="20" Height="96"
                    MouseWheel="Slider_MouseWheel"
                    ValueChanged="VolumeSlider_ValueChanged"/>

            <!-- Module selection overlay (empty — buttons were never added) -->
            <Grid x:Name="ModuleSelection"
                  VerticalAlignment="Top" HorizontalAlignment="Center"
                  MinWidth="232"
                  Margin="16,46,16,0"
                  Opacity="0"
                  Visibility="Hidden">
                <Grid.Resources>
                    <Style TargetType="controls:WindowControlButton">
                        <Setter Property="Scale" Value="0.6"/>
                        <Setter Property="MaxScale" Value="0.65"/>
                        <Setter Property="Width" Value="56"/>
                        <Setter Property="Height" Value="56"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>
            </Grid>

            <!-- Main vertical layout -->
            <StackPanel>

                <!-- ═══ TITLE BAR (InfinClient style) ═══ -->
                <Border Background="{StaticResource FancyColor}" Height="44" Padding="10,0,6,0">
                    <Grid>
                        <!-- Left: Logo circle + App name + version badge -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    Background="{StaticResource AccentColor}" Margin="0,0,9,0">
                                <Path Data="{StaticResource Overlay}" Fill="White"
                                      Stretch="Uniform" Width="13" Height="13"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="INFINLIMIT"
                                       FontFamily="{StaticResource SmallTitleFont}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            <Border CornerRadius="4" Background="{StaticResource DividorColor}"
                                    Padding="5,2" Margin="7,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="25" FontFamily="{StaticResource Kantumruy}" FontSize="9"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </Border>
                        </StackPanel>

                        <!-- Right: Pin + Close -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel.Resources>
                                <Style TargetType="controls:WindowControlButton">
                                    <Setter Property="FillColor" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="GlowColor" Value="{StaticResource AccentColor}"/>
                                    <Setter Property="Height" Value="30"/>
                                    <Setter Property="Width" Value="28"/>
                                    <Setter Property="Scale" Value="0.7"/>
                                    <Setter Property="MaxScale" Value="0.75"/>
                                </Style>
                            </StackPanel.Resources>
                            <controls:WindowControlButton x:Name="Pin" Click="PinClick"
                                                          PathData="{StaticResource Pin}"/>
                            <controls:WindowControlButton Click="ExitButtonClick"
                                                          PathData="{StaticResource CloseIcon}" GlowColor="#d93732"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Line X1="0" X2="290" Stroke="{StaticResource DividorColor}" StrokeThickness="1"/>

                <!-- ═══ TOP BLOCK: Clock + Speed + Active module chips ═══ -->
                <Border x:Name="TopBlock" Background="{StaticResource LightBackColor}" Padding="14,8,14,8">
                    <StackPanel>
                        <Grid>
                            <Label x:Name="CurrentTime" Content="00:00:00"
                                   Padding="0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   FontFamily="{StaticResource BigTextFont}" FontSize="22"
                                   Foreground="{StaticResource AccentColor}"/>
                            <controls:ConnectionInfoPanel x:Name="Speed"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <ItemsControl x:Name="EnabledModules" ItemsSource="{Binding Source={StaticResource ModulesViewSource}}" Margin="0,4,0,-2">
                            <ItemsControl.Resources>
                                <Style TargetType="controls:EnabledModuleTimer">
                                    <Setter Property="Margin" Value="0,0,6,2"/>
                                    <Setter Property="Foreground" Value="{StaticResource TitleColor}"/>
                                    <Setter Property="Scale" Value="0.75"/>
                                </Style>
                            </ItemsControl.Resources>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Left"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Line X1="0" X2="290" Stroke="{StaticResource DividorColor}" StrokeThickness="1"/>

                <!-- ═══ MODULE TABS (InfinClient style: text + underline indicator) ═══ -->
                <Border Background="{StaticResource FancyColor}" Padding="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FontFamily" Value="{StaticResource SmallTitleFont}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <StackPanel Orientation="Vertical">
                                                <ContentPresenter HorizontalAlignment="Center" Margin="10,7,10,4"/>
                                                <Border x:Name="UnderLine" Height="2"
                                                        Background="{StaticResource AccentColor}" Opacity="0"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <Button x:Name="Tab_3074" Content="3074" Tag="PVE"       Click="ModuleTabClick"/>
                        <Button x:Name="Tab_27K"  Content="27K"  Tag="PVP"       Click="ModuleTabClick"/>
                        <Button x:Name="Tab_30K"  Content="30K"  Tag="З0K"       Click="ModuleTabClick"/>
                        <Button x:Name="Tab_7500" Content="7500" Tag="API Block"  Click="ModuleTabClick"/>
                        <Button x:Name="Tab_SWAP" Content="SWAP" Tag="Swapper"   Click="ModuleTabClick"/>
                        <Button x:Name="Tab_SHOT" Content="SHOT" Tag="Multishot" Click="ModuleTabClick"/>
                    </StackPanel>
                </Border>

                <Line X1="0" X2="290" Stroke="{StaticResource DividorColor}" StrokeThickness="1"/>

                <!-- ═══ CONTENT AREA ═══ -->
                <Grid>

                    <!-- MODULE SETTINGS -->
                    <Border x:Name="ModuleSettingsBorder"
                            Background="{StaticResource LightBackColor}"
                            CornerRadius="0,0,12,12" MinHeight="100">
                        <StackPanel x:Name="ModuleSettingsPanel" Margin="0,0,0,8">

                            <!-- MODULE HEADER (DarkLimiter style) -->
                            <Grid Margin="14,10,14,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"
                                             Fill="{StaticResource AccentColor}"/>
                                    <Label x:Name="SelectedModuleLabel" Content="3074"
                                           Padding="0" Margin="0" Height="Auto"
                                           FontFamily="{StaticResource BigTextFont}" FontSize="18"
                                           Foreground="{StaticResource TextPrimary}"
                                           VerticalAlignment="Center"/>
                                </StackPanel>
                                <controls:WindowControlButton Scale="0.85" MaxScale="0.9" Height="14" Width="14"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    PathData="{StaticResource QuestionMark}"
                                    FillColor="{StaticResource InactiveColor}" GlowColor="{StaticResource AccentColor}"
                                    Click="Description_Click"/>
                            </Grid>

                            <!-- Hidden compat elements -->
                            <controls:WindowControlButton x:Name="SelectedModuleButton" Visibility="Collapsed"
                                Width="1" Height="1" Click="ModuleSelectionClick"
                                PathData="{StaticResource ArcIcon}"
                                FillColor="{StaticResource InactiveColor}" GlowColor="{StaticResource TitleColor}"/>

                            <StackPanel x:Name="DescriptionPanel" Margin="14,0,14,4" Visibility="Collapsed">
                                <TextBlock x:Name="Description" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource SmallTitleFont}"/>
                                <Line X1="0" X2="260" Stroke="{StaticResource DividorColor}" StrokeThickness="1" Margin="0,4,0,0"/>
                            </StackPanel>

                            <Line X1="0" X2="290" Stroke="{StaticResource DividorColor}" StrokeThickness="1" Margin="0,0,0,4"/>

                            <!-- SETTINGS -->
                            <Grid MinHeight="64">
                                <StackPanel Orientation="Vertical" Margin="14,0,14,4" VerticalAlignment="Center">
                                    <StackPanel.Resources>
                                        <Style TargetType="Label">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="Opacity" Value="0.9"/>
                                            <Setter Property="FontFamily" Value="{StaticResource SmallTitleFont}"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                        <Style TargetType="controls:Checkbox">
                                            <Setter Property="Margin" Value="6,0,0,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="MinHeight" Value="28"/>
                                        </Style>
                                        <Style TargetType="controls:Button">
                                            <Setter Property="Background" Value="{StaticResource InactiveColor}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="MaxWidth" Value="115"/>
                                            <Setter Property="CornerRadius" Value="7"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Height" Value="22"/>
                                        </Style>
                                    </StackPanel.Resources>

                                    <!--ENABLED-->
                                    <Grid x:Name="ModuleCheckboxGrid">
                                        <Label Content="Enabled" HorizontalAlignment="Left"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <controls:WindowControlButton Scale="1.0" MaxScale="1.0" Height="16" Width="16" Margin="6,0"
                                                PathData="{StaticResource QuestionMark}"
                                                FillColor="{StaticResource InactiveColor}" GlowColor="{StaticResource AccentColor}"
                                                Click="Description_Click"/>
                                            <controls:Checkbox x:Name="ModuleCheckbox" Click="CurrentModuleToggle"/>
                                        </StackPanel>
                                    </Grid>

                                    <!--API SETTINGS-->
                                    <StackPanel x:Name="API_Panel" Visibility="Collapsed">
                                        <Grid ToolTip="Error code prevention">
                                            <Label Content="Auto disable" HorizontalAlignment="Left"/>
                                            <controls:Checkbox x:Name="API_Disable" Click="API_DisableClick"/>
                                        </Grid>
                                        <Grid ToolTip="Injects back dropped packets">
                                            <Label Content="Buffering" HorizontalAlignment="Left"/>
                                            <controls:Checkbox x:Name="API_Buffer" Click="API_BufferClick"/>
                                        </Grid>
                                    </StackPanel>

                                    <!--SWAPPER SETTINGS-->
                                    <StackPanel x:Name="SWAPPER_Panel" Visibility="Collapsed">
                                        <Grid ToolTip="Duration to continuously loop through selected loadouts&#x0a;Examples: 5000 = 5 seconds, 10000 = 10 seconds" Margin="0,3,0,3">
                                            <Label Content="Duration (ms)" HorizontalAlignment="Left"/>
                                            <Border Background="{StaticResource InactiveColor}"
                                                    BorderBrush="{StaticResource AccentColor}"
                                                    BorderThickness="1" CornerRadius="5"
                                                    Width="60" Height="22"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBox x:Name="SwapperDuration" Text="5000"
                                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                         FontFamily="{StaticResource Kantumruy}" FontSize="12"
                                                         Background="Transparent" Foreground="{StaticResource TitleColor}"
                                                         BorderThickness="0" Padding="2"
                                                         TextChanged="SwapperDuration_TextChanged"/>
                                            </Border>
                                        </Grid>
                                        <Grid ToolTip="Loadout number (1-12) to end the sequence on&#x0a;Will switch to this loadout when loop duration expires" Margin="0,0,0,3">
                                            <Label Content="Final loadout" HorizontalAlignment="Left"/>
                                            <Border Background="{StaticResource InactiveColor}"
                                                    BorderBrush="{StaticResource AccentColor}"
                                                    BorderThickness="1" CornerRadius="5"
                                                    Width="35" Height="22"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBox x:Name="SwapperFinalLoadout" Text="1"
                                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                         FontFamily="{StaticResource Kantumruy}" FontSize="12"
                                                         Background="Transparent" Foreground="{StaticResource TitleColor}"
                                                         BorderThickness="0" Padding="2"
                                                         TextChanged="SwapperFinalLoadout_TextChanged"/>
                                            </Border>
                                        </Grid>
                                        <Grid ToolTip="Activate PVE Upload blocking during loadout swapping" Margin="0,0,0,3">
                                            <Label Content="3074 UL" HorizontalAlignment="Left"/>
                                            <controls:Button x:Name="SwapperModule3074UL" Text="No keybind" Click="KeybindButtonClick" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid ToolTip="Activate PVE Download blocking during loadout swapping" Margin="0,0,0,3">
                                            <Label Content="3074 DL" HorizontalAlignment="Left"/>
                                            <controls:Button x:Name="SwapperModule3074DL" Text="No keybind" Click="KeybindButtonClick" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid ToolTip="Activate PVP Upload blocking during loadout swapping" Margin="0,0,0,3">
                                            <Label Content="27k UL" HorizontalAlignment="Left"/>
                                            <controls:Button x:Name="SwapperModule27kUL" Text="No keybind" Click="KeybindButtonClick" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid ToolTip="Select which loadouts to cycle through during the loop" Margin="0,6,0,3">
                                            <Label Content="Loadout selection" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <Grid ToolTip="Include Loadout 1 in the loop cycle" Margin="0,2">
                                                    <Label Content="Loadout 1" HorizontalAlignment="Left" FontSize="12"/>
                                                    <controls:Checkbox x:Name="Swapper_Loadout1" Click="Swapper_LoadoutButton_Click" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid ToolTip="Include Loadout 3 in the loop cycle" Margin="0,2">
                                                    <Label Content="Loadout 3" HorizontalAlignment="Left" FontSize="12"/>
                                                    <controls:Checkbox x:Name="Swapper_Loadout3" Click="Swapper_LoadoutButton_Click" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid ToolTip="Include Loadout 5 in the loop cycle" Margin="0,2">
                                                    <Label Content="Loadout 5" HorizontalAlignment="Left" FontSize="12"/>
                                                    <controls:Checkbox x:Name="Swapper_Loadout5" Click="Swapper_LoadoutButton_Click" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid ToolTip="Include Loadout 7 in the loop cycle" Margin="0,2">
                                                    <Label Content="Loadout 7" HorizontalAlignment="Left" FontSize="12"/>
                                                    <controls:Checkbox x:Name="Swapper_Loadout7" Click="Swapper_LoadoutButton_Click" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid ToolTip="Include Loadout 9 in the loop cycle" Margin="0,2">
                                                    <Label Content="Loadout 9" HorizontalAlignment="Left" FontSize="12"/>
                                                    <controls:Checkbox x:Name="Swapper_Loadout9" Click="Swapper_LoadoutButton_Click" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid ToolTip="Include Loadout 11 in the loop cycle" Margin="0,2">
                                                    <Label Content="Loadout 11" HorizontalAlignment="Left" FontSize="12"/>
                                                    <controls:Checkbox x:Name="Swapper_Loadout11" Click="Swapper_LoadoutButton_Click" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <Grid ToolTip="Include Loadout 2 in the loop cycle" Margin="0,2">
                                                    <Label Content="Loadout 2" HorizontalAlignment="Left" FontSize="12"/>
                                                    <controls:Checkbox x:Name="Swapper_Loadout2" Click="Swapper_LoadoutButton_Click" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid ToolTip="Include Loadout 4 in the loop cycle" Margin="0,2">
                                                    <Label Content="Loadout 4" HorizontalAlignment="Left" FontSize="12"/>
                                                    <controls:Checkbox x:Name="Swapper_Loadout4" Click="Swapper_LoadoutButton_Click" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid ToolTip="Include Loadout 6 in the loop cycle" Margin="0,2">
                                                    <Label Content="Loadout 6" HorizontalAlignment="Left" FontSize="12"/>
                                                    <controls:Checkbox x:Name="Swapper_Loadout6" Click="Swapper_LoadoutButton_Click" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid ToolTip="Include Loadout 8 in the loop cycle" Margin="0,2">
                                                    <Label Content="Loadout 8" HorizontalAlignment="Left" FontSize="12"/>
                                                    <controls:Checkbox x:Name="Swapper_Loadout8" Click="Swapper_LoadoutButton_Click" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid ToolTip="Include Loadout 10 in the loop cycle" Margin="0,2">
                                                    <Label Content="Loadout 10" HorizontalAlignment="Left" FontSize="12"/>
                                                    <controls:Checkbox x:Name="Swapper_Loadout10" Click="Swapper_LoadoutButton_Click" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid ToolTip="Include Loadout 12 in the loop cycle" Margin="0,2">
                                                    <Label Content="Loadout 12" HorizontalAlignment="Left" FontSize="12"/>
                                                    <controls:Checkbox x:Name="Swapper_Loadout12" Click="Swapper_LoadoutButton_Click" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!--MULTISHOT SETTINGS-->
                                    <StackPanel x:Name="MULTISHOT_Panel" Visibility="Visible">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" ToolTip="Blocks updates sent by server&#x0a;Better for efficiency">
                                                <Label Content="DL" HorizontalAlignment="Left"/>
                                                <controls:Checkbox x:Name="MS_INBOUND" Click="MS_InboundClick"/>
                                            </Grid>
                                            <Grid Grid.Column="2" ToolTip="Blocks updates sent to server&#x0a;Injects shots as single big shot on deactivation&#x0a;Limited multiplying efficiency&#x0a;Works good on lower timelimit values">
                                                <Label Content="UL" HorizontalAlignment="Left"/>
                                                <controls:Checkbox x:Name="MS_OUTBOUND" Click="MS_OutboundClick"/>
                                            </Grid>
                                        </Grid>
                                        <StackPanel ToolTip="Speed over multiplying efficiency preference">
                                            <Grid>
                                                <Label Content="Time limit" HorizontalAlignment="Left"/>
                                                <Label x:Name="MS_MaxTime" Content="0.0sec" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="MS_MaxTimeSlider" Style="{StaticResource Slider}" Margin="0,2"
                                                    Minimum="0.5" Maximum="1.8" TickFrequency="0.05"
                                                    MouseWheel="Slider_MouseWheel" ValueChanged="MS_MaxTimeSlider_ValueChanged"/>
                                        </StackPanel>
                                        <Grid ToolTip="Activate on shot packet instead of LMB&#x0a;Good for fusion rifles&#x0a;Can be inconsistent&#x0a;Doesn't work alone">
                                            <Label Content="Shot detection" HorizontalAlignment="Left"/>
                                            <controls:Checkbox x:Name="MS_DETECT" Click="MS_DetectClick"/>
                                        </Grid>
                                        <Grid ToolTip="Make it work passively">
                                            <Label Content="Togglable" HorizontalAlignment="Left"/>
                                            <controls:Checkbox x:Name="MS_TOGGLABLE" Click="MS_TogglableClick"/>
                                        </Grid>
                                        <Grid ToolTip="Multiply shots sent to players&#x0a;Works on pve port if disabled&#x0a;Keybind purely toggles the setting" Margin="0,0,0,2">
                                            <Label Content="Players" HorizontalAlignment="Left"/>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <controls:Button x:Name="MS_PVPKeybind" Text="No keybind" Click="KeybindButtonClick"/>
                                                <controls:Checkbox x:Name="MS_PVP" Click="MS_PlayersClick" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!--INSTANCE (PVE) SETTINGS-->
                                    <StackPanel x:Name="INSTANCE_Panel" Visibility="Collapsed">
                                        <Grid Margin="0,0,0,3" ToolTip="Injects back dropped packets">
                                            <Label Content="Buffering" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <controls:Checkbox x:Name="InstBufferCB" Click="InstBufferCBClick" Margin="6,0,0,0"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,3" ToolTip="Enable rate-limited packet release instead of blocking">
                                            <Label Content="30k slow" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <controls:Checkbox x:Name="InstSlowCB" Click="InstSlowCBClick" Margin="6,0,0,0"/>
                                        </Grid>
                                        <Grid ToolTip="Bits per second rate limit for 30k slow mode&#x0a;Examples: 500000 = 500 Kbps, 1000000 = 1 Mbps" Margin="0,0,0,3">
                                            <Label Content="B/s" HorizontalAlignment="Left"/>
                                            <Border Background="{StaticResource InactiveColor}"
                                                    BorderBrush="{StaticResource AccentColor}"
                                                    BorderThickness="1" CornerRadius="5"
                                                    Width="80" Height="22"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBox x:Name="InstRateLimitTB" Text="1000000"
                                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                         FontFamily="{StaticResource Kantumruy}" FontSize="12"
                                                         Background="Transparent" Foreground="{StaticResource TitleColor}"
                                                         BorderThickness="0" Padding="2"
                                                         TextChanged="InstRateLimitTB_TextChanged"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <!--PVP SETTINGS-->
                                    <StackPanel x:Name="PVP_Panel" Visibility="Collapsed">
                                        <Grid ToolTip="Block info sent to players" Margin="0,3,0,0">
                                            <Label Content="UL" HorizontalAlignment="Left"/>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <controls:Button x:Name="PvpOutbound" Text="No keybind" Click="KeybindButtonClick"/>
                                                <controls:Checkbox x:Name="PvpOutCB" Click="PvpOutCBClick" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,3,0,3" ToolTip="Allows to reinitiate connection with players on desync&#x0a;Experimental and not error-code proof">
                                            <Label Content="Auto-resync" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <controls:Checkbox x:Name="PvpResyncCB" Click="PvpResyncCBClick" Margin="6,0,0,0"/>
                                        </Grid>
                                        <Grid ToolTip="Injects back dropped packets">
                                            <Label Content="Buffering" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <controls:Checkbox x:Name="PvpBufferCB" Click="PvpBufferCBClick" Margin="6,0,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <!--PVE SETTINGS-->
                                    <StackPanel x:Name="PVE_Panel" Visibility="Collapsed">
                                        <Grid ToolTip="Block info sent by server" Margin="0,3,0,3">
                                            <Label Content="DL" HorizontalAlignment="Left"/>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <controls:Button x:Name="PveInbound" Text="No keybind" Click="KeybindButtonClick"/>
                                                <controls:Checkbox x:Name="PveInCB" Click="PveInCBClick" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ToolTip="Block info sent to server" Margin="0,0,0,3">
                                            <Label Content="UL" HorizontalAlignment="Left"/>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <controls:Button x:Name="PveOutbound" Text="No keybind" Click="KeybindButtonClick"/>
                                                <controls:Checkbox x:Name="PveOutCB" Click="PveOutCBClick" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ToolTip="Slow down world updates sent from server by x20&#x0a;Keeps you out of resync for longer periods" Margin="0,0,0,3">
                                            <Label Content="DL Slow" HorizontalAlignment="Left"/>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <controls:Button x:Name="PveSlowInbound" Text="No keybind" Click="KeybindButtonClick"/>
                                                <controls:Checkbox x:Name="PveSlowInCB" Click="PveSlowInCBClick" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ToolTip="Slow down world updates sent to server by x20&#x0a;Experimental, not tested" Margin="0,0,0,3">
                                            <Label Content="UL Slow" HorizontalAlignment="Left"/>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <controls:Button x:Name="PveSlowOutbound" Text="No keybind" Click="KeybindButtonClick"/>
                                                <controls:Checkbox x:Name="PveSlowOutCB" Click="PveSlowOutCBClick" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,3" ToolTip="Allows to reinitiate connection with the server on desync&#x0a;Prevents most error-code cases">
                                            <Label Content="Auto-resync" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <controls:Checkbox x:Name="PveResyncCB" Click="PveResyncCBClick" Margin="6,0,0,0"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,3" ToolTip="Injects back dropped packets">
                                            <Label Content="Buffering" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <controls:Checkbox x:Name="PveBufferCB" Click="PveBufferCBClick" Margin="6,0,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <!--ACTIVATION-->
                                    <Grid x:Name="ActivationGrid">
                                        <Label x:Name="kbd" Content="Keybind" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <controls:Button x:Name="KeybindButton" Text="No keybind" MaxWidth="100" Click="KeybindButtonClick"/>
                                            <controls:Checkbox x:Name="PvpInCB" Visibility="Collapsed" Click="PvpInCBClick" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- CONSOLE LIMITER PAGE (overlay) -->
                    <Border x:Name="ConsolePage"
                            Visibility="Collapsed"
                            VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                            Background="#080C14" CornerRadius="0,0,12,12"
                            Padding="16">
                        <wincontrols:ConsoleLimiterPanel x:Name="ConsolePanelControl"/>
                    </Border>

                </Grid>

                <Line X1="0" X2="290" Stroke="{StaticResource DividorColor}" StrokeThickness="1"/>

                <!-- ═══ BOTTOM BAR: secondary controls ═══ -->
                <Border Background="{StaticResource LightBackColor}" CornerRadius="0,0,12,12" Padding="6,4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Resources>
                            <Style TargetType="controls:WindowControlButton">
                                <Setter Property="FillColor" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="GlowColor" Value="{StaticResource AccentColor}"/>
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="Width" Value="32"/>
                                <Setter Property="Scale" Value="0.72"/>
                                <Setter Property="MaxScale" Value="0.8"/>
                                <Setter Property="Margin" Value="2,0"/>
                            </Style>
                        </StackPanel.Resources>

                        <controls:WindowControlButton Click="TrayButtonClick"
                                                      PathData="{StaticResource HideIcon}"/>
                        <controls:WindowControlButton x:Name="Overlay" Click="OverlayClick"
                                                      PathData="{StaticResource Overlay}"/>
                        <controls:WindowControlButton x:Name="OpenLogs" Click="LogButtonClick"
                                                      PathData="{StaticResource LogIcon}"/>
                        <controls:WindowControlButton Click="ServiceWindowButtonClick"
                                                      PathData="{StaticResource SettingsIcon}"/>
                        <controls:WindowControlButton Click="AhkClick"
                                                      PathData="{StaticResource AhkIcon}"/>
                        <controls:WindowControlButton Click="SoundButtonClick"
                                                      PathData="M3 9 L3 15 L7 15 L12 20 L12 4 L7 9 Z M13.5 12 C13.5 10.23 12.48 8.71 11 7.97 L11 16.02 C12.48 15.29 13.5 13.77 13.5 12 Z M11 3.23 L11 5.29 C14.89 6.15 18 9.46 18 12 C18 14.54 14.89 17.85 11 18.71 L11 20.77 C16.52 19.86 21 16.07 21 12 C21 7.93 16.52 4.14 11 3.23 Z"/>
                        <controls:WindowControlButton x:Name="ConsoleButton" Click="ConsoleButtonClick"
                                                      PathData="{StaticResource ConsoleIcon}"/>
                    </StackPanel>
                </Border>

            </StackPanel>

        </Grid>
    </Grid>
</Window>
