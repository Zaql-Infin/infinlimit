<Window x:Class="InfinLimit.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InfinLimit.Controls"
        xmlns:local="clr-namespace:InfinLimit.Windows"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        SizeToContent="Manual"
        x:Name="Win"
        Title="">

    <Window.Resources>
        <!-- #eeffffff — the icon tint used across the HUD -->
        <SolidColorBrush x:Key="ModuleBrush" Color="#eeffffff"/>
    </Window.Resources>

    <!-- Root element carries the pincushion lens effect; Width/Height set in code -->
    <Grid x:Name="Root">

        <!-- Horizontal gradient line just above the module strip -->
        <Rectangle VerticalAlignment="Top" HorizontalAlignment="Stretch"
                   Height="2" Margin="0,42,0,0" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#bbffffff" Offset="0"/>
                    <GradientStop Color="#50181818" Offset="0.85"/>
                    <GradientStop Color="#00000000" Offset="0.95"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Module strip -->
        <StackPanel x:Name="ModulesGrid"
                    VerticalAlignment="Top" HorizontalAlignment="Left"
                    Margin="0,44,0,0" IsHitTestVisible="False">

            <!-- EnabledModuleTimer icons (populated in code-behind) -->
            <StackPanel x:Name="Modules" Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="controls:EnabledModuleTimer">
                        <Setter Property="Padding" Value="0,2,3,4"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Foreground" Value="{StaticResource ModuleBrush}"/>
                        <Setter Property="MinOpacity" Value="1.0"/>
                        <Setter Property="Scale" Value="0.74"/>
                    </Style>
                </StackPanel.Resources>
            </StackPanel>

            <!-- Instance / session timer row -->
            <StackPanel x:Name="Counters" Orientation="Horizontal">
                <Label x:Name="InstanceTimerLabel"
                       Visibility="Collapsed"
                       Foreground="{StaticResource ModuleBrush}"
                       FontFamily="{StaticResource SmallTitleFont}"
                       FontWeight="ExtraBold"
                       FontSize="30"
                       Opacity="0.96"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Left">
                    <Label.Effect>
                        <DropShadowEffect ShadowDepth="0" Color="Black" BlurRadius="3"/>
                    </Label.Effect>
                </Label>
            </StackPanel>

            <!-- Raid/dungeon counter (hidden until tracker has data) -->
            <StackPanel x:Name="RaidStack" Orientation="Horizontal"
                        Visibility="Collapsed" Margin="7,0,0,0">
                <Ellipse Width="7" Height="7" Fill="#ee67c06b"
                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                <Label x:Name="RaidLabel"
                       Foreground="#ee67c06b"
                       FontFamily="{StaticResource SmallTitleFont}"
                       FontWeight="ExtraBold"
                       FontSize="24"
                       Opacity="0.96"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Left"
                       Margin="7,2,-4,0">
                    <Label.Effect>
                        <DropShadowEffect ShadowDepth="0" Color="Black" BlurRadius="3"/>
                    </Label.Effect>
                </Label>
            </StackPanel>

        </StackPanel>

    </Grid>
</Window>
