<Window x:Class="InfinLimit.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#FFFF00FF"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        x:Name="Win"
        Title="">
    <!-- Background="#FFFF00FF" is magenta — keyed out to transparent by SetLayeredWindowAttributes.
         The inner Border provides the visible dark panel. -->
    <Border MouseLeftButtonDown="Border_MouseLeftButtonDown"
            Background="#E01c1c22"
            CornerRadius="6">
        <StackPanel x:Name="Rows" Margin="10,7,10,7"/>
    </Border>
</Window>
