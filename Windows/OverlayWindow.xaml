<Window x:Class="InfinLimit.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InfinLimit.Controls"
        xmlns:local="clr-namespace:InfinLimit.Windows"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        x:Name="Win"
        Title="">

    <Window.Resources>
        <!-- #eeffffff — the icon tint used across the HUD -->
        <SolidColorBrush x:Key="ModuleBrush" Color="#eeffffff"/>
    </Window.Resources>

    <!-- Root element carries the pincushion lens effect; Width/Height set in code -->
    <Grid x:Name="Root">

        <!-- Module strip -->
        <StackPanel x:Name="ModulesGrid"
                    VerticalAlignment="Top" HorizontalAlignment="Left"
                    Margin="8,8,8,8" IsHitTestVisible="False">

            <!-- Module icons populated in code-behind (Path+Label per module) -->
            <StackPanel x:Name="Modules" Orientation="Horizontal"/>

            <!-- Instance / session timer row -->
            <StackPanel x:Name="Counters" Orientation="Horizontal">
                <Label x:Name="InstanceTimerLabel"
                       Visibility="Collapsed"
                       Foreground="{StaticResource ModuleBrush}"
                       FontFamily="{StaticResource SmallTitleFont}"
                       FontWeight="ExtraBold"
                       FontSize="30"
                       Opacity="0.96"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Left">
                    <Label.Effect>
                        <DropShadowEffect ShadowDepth="0" Color="Black" BlurRadius="3"/>
                    </Label.Effect>
                </Label>
            </StackPanel>

            <!-- Raid/dungeon counter (hidden until tracker has data) -->
            <StackPanel x:Name="RaidStack" Orientation="Horizontal"
                        Visibility="Collapsed" Margin="7,0,0,0">
                <Ellipse Width="7" Height="7" Fill="#ee67c06b"
                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                <Label x:Name="RaidLabel"
                       Foreground="#ee67c06b"
                       FontFamily="{StaticResource SmallTitleFont}"
                       FontWeight="ExtraBold"
                       FontSize="24"
                       Opacity="0.96"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Left"
                       Margin="7,2,-4,0">
                    <Label.Effect>
                        <DropShadowEffect ShadowDepth="0" Color="Black" BlurRadius="3"/>
                    </Label.Effect>
                </Label>
            </StackPanel>

        </StackPanel>

    </Grid>
</Window>
