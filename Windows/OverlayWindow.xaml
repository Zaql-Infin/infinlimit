<Window x:Class="InfinLimit.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InfinLimit.Windows"
        xmlns:controls="clr-namespace:InfinLimit.Controls"
        mc:Ignorable="d"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        x:Name="Win"
        Title="">

    <Window.Resources>
        <!-- D2 gold for active modules -->
        <SolidColorBrush x:Key="ModuleBrush" Color="#C8A951"/>
        <!-- D2 dark panel backing -->
        <SolidColorBrush x:Key="Back" Color="#C8A951"/>
    </Window.Resources>

    <Grid x:Name="Content" Width="2560" Height="1440"
          Margin="-118,0,0,0">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <Grid.Effect>
            <local:PincushionEffect
                Width="{Binding Width, ElementName=Win, Converter={StaticResource Math}, ConverterParameter=x*4}"
                Height="{Binding Height, ElementName=Win, Converter={StaticResource Math}, ConverterParameter=x*4}"
                Power="-0.31"/>
        </Grid.Effect>

        <!--PLACEHOLDER-->
        <Line X1="0" X2="2560" Y1="0" Y2="1440" Stroke="#00000000"/>

        <!-- D2-style HUD panel: bottom-left corner bracket + module strip -->
        <Grid x:Name="ModulesGrid"
              VerticalAlignment="Top"
              HorizontalAlignment="Left"
              Margin="0,44,0,0">

            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1.22"/>
            </Grid.RenderTransform>

            <!-- D2 corner: diagonal slash in gold -->
            <Line X1="0" Y1="0" X2="42" Y2="42"
                  StrokeThickness="1.5" Stroke="#88C8A951"/>

            <!-- D2 corner triangle accent in gold -->
            <Polygon HorizontalAlignment="Left" Margin="0,0,0,10"
                     Width="42" Height="42"
                     Points="0,0 42,0 42,42"
                     RenderTransformOrigin="0.5,0.5">
                <Polygon.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#99C8A951" Offset="0"/>
                        <GradientStop Color="#44C8A951" Offset="0.6"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Polygon.Fill>
                <Polygon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="179.495"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Polygon.RenderTransform>
            </Polygon>

            <!-- D2 module info strip -->
            <Grid Height="42" Margin="42,-10,0,0">
                <Border VerticalAlignment="Top" Height="42" MinWidth="210">
                    <Border.Width>
                        <MultiBinding ConverterParameter="Min(x + 80, 480)" Converter="{StaticResource Math}">
                            <Binding Path="ActualWidth" ElementName="DisplayLine"/>
                        </MultiBinding>
                    </Border.Width>
                    <Border.Background>
                        <LinearGradientBrush>
                            <!-- D2 dark translucent backing with faint gold tint -->
                            <GradientStop Color="#88100F0A" Offset="0"/>
                            <GradientStop Color="#771A1710" Offset="0.75"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- D2 gold top edge line on the strip -->
                <Border VerticalAlignment="Top" Height="1" MinWidth="210" Opacity="0.5">
                    <Border.Width>
                        <MultiBinding ConverterParameter="Min(x + 80, 480)" Converter="{StaticResource Math}">
                            <Binding Path="ActualWidth" ElementName="DisplayLine"/>
                        </MultiBinding>
                    </Border.Width>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#C8A951" Offset="0"/>
                            <GradientStop Color="#C8A951" Offset="0.7"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel x:Name="DisplayLine" VerticalAlignment="Top" HorizontalAlignment="Left"
                            Orientation="Horizontal">

                    <StackPanel x:Name="Modules" Height="42" MinWidth="255" MaxWidth="255"
                                Orientation="Horizontal" HorizontalAlignment="Left">
                        <StackPanel.Resources>
                            <Style TargetType="controls:EnabledModuleTimer">
                                <Setter Property="Margin" Value="0,2,3,4"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{StaticResource ModuleBrush}"/>
                                <Setter Property="MinOpacity" Value="1.0"/>
                                <Setter Property="Scale" Value="0.74"/>
                            </Style>
                        </StackPanel.Resources>
                    </StackPanel>

                    <StackPanel Name="Counters" Height="43" Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="Path">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Stretch" Value="Uniform"/>
                                <Setter Property="Margin" Value="0,2,4,2"/>
                                <Setter Property="Height" Value="39"/>
                                <Setter Property="Width" Value="39"/>
                                <Setter Property="Fill">
                                    <Setter.Value>
                                        <!-- D2 gold-to-transparent icon fill -->
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F0E8B8" Offset="0"/>
                                            <GradientStop Color="#C8A951" Offset="0.5"/>
                                            <GradientStop Color="Transparent" Offset="0.9"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>

                        <!-- D2-style timer: gold text, Bahnschrift Light font -->
                        <Label Name="Timer" Content="00:00:00"
                               MinWidth="120" MaxWidth="120"
                               Visibility="Collapsed"
                               FontSize="30"
                               FontFamily="{StaticResource SmallTitleFont}"
                               FontWeight="Bold"
                               HorizontalContentAlignment="Left"
                               VerticalContentAlignment="Center"
                               Foreground="{StaticResource ModuleBrush}">
                            <Label.Effect>
                                <DropShadowEffect ShadowDepth="0" Color="#C8A951" BlurRadius="6" Opacity="0.5"/>
                            </Label.Effect>
                            <Label.LayoutTransform>
                                <ScaleTransform ScaleX="0.96"/>
                            </Label.LayoutTransform>
                        </Label>

                        <!-- D2 raid/encounter counter -->
                        <Grid x:Name="Raid" Visibility="Collapsed" Margin="7,0,0,0">
                            <Grid.Effect>
                                <DropShadowEffect ShadowDepth="0" Color="#C8A951" BlurRadius="4" Opacity="0.35"/>
                            </Grid.Effect>

                            <!-- D2 diamond indicator instead of circle -->
                            <Path Width="8" Height="8"
                                  Data="M4 0L8 4L4 8L0 4Z"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform">
                                <Path.Fill>
                                    <SolidColorBrush Color="#EEC86A"/>
                                </Path.Fill>
                            </Path>

                            <Label x:Name="RaidLabel"
                                   Foreground="{StaticResource ModuleBrush}"
                                   Content="0"
                                   FontFamily="{StaticResource SmallTitleFont}"
                                   FontSize="24"
                                   VerticalContentAlignment="Center"
                                   HorizontalContentAlignment="Left"
                                   Margin="10,2,-4,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right">
                                <Label.LayoutTransform>
                                    <ScaleTransform ScaleX="0.96"/>
                                </Label.LayoutTransform>
                            </Label>
                        </Grid>

                    </StackPanel>
                </StackPanel>

            </Grid>
        </Grid>
    </Grid>
</Window>
