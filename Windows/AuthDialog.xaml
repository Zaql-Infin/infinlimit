<Window x:Class="InfinLimit.AuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InfinLimit.Controls"
        SizeToContent="WidthAndHeight"
        Style="{StaticResource TransparentWindow}">

    <Grid Margin="18,10,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar row with close button -->
        <Grid Grid.Row="0">
            <TextBlock x:Name="TitleText"
                       Text="Not Authorized"
                       Foreground="{StaticResource AccentColor}"
                       FontFamily="{StaticResource SmallTitleFont}"
                       FontSize="15" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <controls:WindowControlButton Click="OkClick"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          PathData="{StaticResource CloseIcon}"
                                          Scale="0.95" MaxScale="1.0" Height="20" Width="20"
                                          FillColor="{StaticResource InactiveColor}" GlowColor="#d93732"/>
        </Grid>

        <!-- Divider -->
        <Line Grid.Row="1" X1="0" X2="300"
              StrokeThickness="1" Stroke="{StaticResource InactiveColor}" Opacity="0.5"/>

        <!-- Message -->
        <TextBlock x:Name="MessageText"
                   Grid.Row="3"
                   Text="Your PC is not approved for InfinLimiter."
                   Foreground="{StaticResource TextPrimary}"
                   FontFamily="{StaticResource BigTextFont}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   MaxWidth="300"/>

        <!-- HWID row -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Read-only selectable HWID box -->
            <Border Grid.Column="0" Background="{StaticResource LightBackColor}"
                    CornerRadius="6" Padding="8,5" Margin="0,0,6,0">
                <TextBox x:Name="HwidBox"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource AccentColor}"
                         FontFamily="Consolas" FontSize="12"
                         CaretBrush="{StaticResource AccentColor}"
                         SelectionBrush="{StaticResource AccentColor}"
                         VerticalAlignment="Center"
                         Cursor="IBeam"/>
            </Border>

            <!-- Copy button -->
            <Border Grid.Column="1" x:Name="CopyBorder"
                    Background="{StaticResource LightBackColor}"
                    CornerRadius="6" Padding="10,5"
                    Cursor="Hand"
                    MouseEnter="CopyBorder_MouseEnter"
                    MouseLeave="CopyBorder_MouseLeave"
                    MouseLeftButtonDown="CopyBorder_Click">
                <TextBlock x:Name="CopyLabel"
                           Text="Copy"
                           Foreground="{StaticResource TextSecondary}"
                           FontFamily="{StaticResource BigTextFont}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

    </Grid>
</Window>
