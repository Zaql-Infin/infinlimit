<Window x:Class="InfinLimit.Windows.ScanResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource TransparentWindow}"
        Title="Select Device" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20" MinWidth="280">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="SELECT  DEVICE" Foreground="#00D4FF"
                       FontFamily="Bahnschrift Light" FontSize="13"/>
            <Button HorizontalAlignment="Right" Content="✕"
                    Foreground="#6B7FA3" Background="Transparent" BorderThickness="0"
                    FontSize="14" Cursor="Hand" Click="Cancel_Click"/>
        </Grid>

        <TextBlock Grid.Row="1" Text="Devices found on your network:" Foreground="#6B7FA3"
                   FontFamily="Bahnschrift Light" FontSize="11" Margin="0,0,0,8"/>

        <!-- IP List -->
        <ListBox Grid.Row="2" x:Name="IpList" Background="Transparent" BorderThickness="0"
                 MaxHeight="220" SelectionMode="Single">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,7"/>
                    <Setter Property="Foreground" Value="#E8F0FF"/>
                    <Setter Property="FontFamily" Value="Bahnschrift Light"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}"
                                        Margin="0,2">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#0E1622"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#0A2033"/>
                                        <Setter Property="Foreground" Value="#00D4FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="CANCEL" Click="Cancel_Click" Margin="0,0,8,0"
                    Background="#0E1622" Foreground="#6B7FA3" BorderBrush="#1A2540"
                    BorderThickness="1" Padding="12,5" FontFamily="Bahnschrift Light"
                    FontSize="11" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="SELECT" Click="Select_Click"
                    Background="#004466" Foreground="#00D4FF" BorderBrush="#00D4FF"
                    BorderThickness="1" Padding="12,5" FontFamily="Bahnschrift Light"
                    FontSize="11" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
