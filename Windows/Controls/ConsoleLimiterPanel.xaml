<UserControl x:Class="InfinLimit.Windows.Controls.ConsoleLimiterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:InfinLimit.Controls"
             xmlns:modules="clr-namespace:InfinLimit.Interception.Modules"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Priority enum values for ComboBox binding -->
        <x:Array x:Key="PriorityValues" Type="{x:Type modules:DevicePriority}">
            <modules:DevicePriority>High</modules:DevicePriority>
            <modules:DevicePriority>Normal</modules:DevicePriority>
            <modules:DevicePriority>Low</modules:DevicePriority>
            <modules:DevicePriority>Blocked</modules:DevicePriority>
        </x:Array>

        <Style x:Key="PriorityBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BackColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividorColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Bahnschrift Light"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="3,1,0,1"/>
            <Setter Property="ItemsSource" Value="{StaticResource PriorityValues}"/>
        </Style>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontFamily" Value="Bahnschrift Light"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Bahnschrift Light"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="-6,-5"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <Style x:Key="LimitBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BackColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividorColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2,2"/>
            <Setter Property="FontFamily" Value="Bahnschrift Light"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource LightBackColor}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontFamily" Value="Bahnschrift Light"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#E85D5D"/>
            <Setter Property="BorderBrush" Value="#E85D5D"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0" Orientation="Vertical" MinWidth="380">

        <!-- Header row: icon + title + master enable toggle -->
        <Grid Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M7 6H17C18.6 6 20 7 20.8 8.4L22 11V15C22 16.1 21.1 17 20 17H4C2.9 17 2 16.1 2 15V11L3.2 8.4C4 7 5.4 6 7 6ZM10 10H8V8H6V10H4V12H6V14H8V12H10V10ZM16 9C15.4 9 15 9.4 15 10S15.4 11 16 11 17 10.6 17 10 16.6 9 16 9ZM18 11C17.4 11 17 11.4 17 12S17.4 13 18 13 19 12.6 19 12 18.6 11 18 11Z"
                      Fill="{StaticResource AccentColor}" Stretch="Uniform" Width="14" Height="14"
                      Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Foreground="{StaticResource AccentColor}"
                           FontFamily="Bahnschrift Light" FontSize="12" VerticalAlignment="Center"
                           Text="Console Limiter"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="EnabledLabel" Text="OFF" Foreground="{StaticResource TextSecondary}"
                           FontFamily="Bahnschrift Light" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <controls:Checkbox x:Name="ChkEnabled"
                                   VerticalAlignment="Center" MouseDown="ChkEnabled_Click"/>
            </StackPanel>
        </Grid>

        <!-- Setup info banner -->
        <Border Background="{StaticResource BackColor}" BorderBrush="{StaticResource DividorColor}"
                BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Console must be on the same network as this PC"
                           Foreground="{StaticResource TextPrimary}"
                           FontFamily="Bahnschrift Light" FontSize="11"/>
                <TextBlock Text="Add your console's IP below, then enable Console Limiter to connect"
                           Foreground="{StaticResource TextSecondary}"
                           FontFamily="Bahnschrift Light" FontSize="9" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Table column headers -->
        <Border Background="{StaticResource BackColor}" BorderBrush="{StaticResource DividorColor}"
                BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="8,4">
            <Grid>
                <TextBlock Text="CONSOLE" Style="{StaticResource ColHeader}" HorizontalAlignment="Left"/>
            </Grid>
        </Border>

        <!-- Device rows -->
        <Border BorderBrush="{StaticResource DividorColor}" BorderThickness="1,0,1,1"
                CornerRadius="0,0,4,4">
            <StackPanel>
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="DeviceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource DividorColor}"
                                            BorderThickness="0,0,0,1" Padding="8,5"
                                            Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Console name + IP -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontFamily="Bahnschrift Light" FontSize="12"/>
                                                <TextBlock Text="{Binding IP}"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           FontFamily="Bahnschrift Light" FontSize="10"/>
                                            </StackPanel>

                                            <!-- Remove -->
                                            <Button Grid.Column="1" Content="✕"
                                                    Style="{StaticResource DangerButton}"
                                                    Width="22" Height="22" Padding="0" FontSize="9"
                                                    Margin="3,0,0,0" VerticalAlignment="Center"
                                                    Tag="{Binding}" Click="RemoveDevice_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Margin="0,16,0,12">
                            <Path Data="M7 6H17C18.6 6 20 7 20.8 8.4L22 11V15C22 16.1 21.1 17 20 17H4C2.9 17 2 16.1 2 15V11L3.2 8.4C4 7 5.4 6 7 6ZM10 10H8V8H6V10H4V12H6V14H8V12H10V10ZM16 9C15.4 9 15 9.4 15 10S15.4 11 16 11 17 10.6 17 10 16.6 9 16 9ZM18 11C17.4 11 17 11.4 17 12S17.4 13 18 13 19 12.6 19 12 18.6 11 18 11Z"
                                  Fill="{StaticResource InactiveColor}" Stretch="Uniform"
                                  Width="22" Height="22" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="No consoles added" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="Bahnschrift Light" FontSize="11"/>
                            <TextBlock Text="Add an Xbox or PlayStation IP below" HorizontalAlignment="Center"
                                       Foreground="{StaticResource InactiveColor}"
                                       FontFamily="Bahnschrift Light" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Add device row -->
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BackColor}"
                    BorderBrush="{StaticResource DividorColor}" BorderThickness="1"
                    CornerRadius="4" Margin="0,0,5,0">
                <Grid>
                    <TextBox x:Name="NewDeviceIP" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimary}"
                             FontFamily="Bahnschrift Light" FontSize="11"
                             Padding="6,3" CaretBrush="{StaticResource AccentColor}"
                             ToolTip="Console IP — find it in the hotspot's connected device list"/>
                    <TextBlock Text="Console IP (e.g. 192.168.137.50)..." IsHitTestVisible="False"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="Bahnschrift Light" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=NewDeviceIP}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Button Grid.Column="1" Content="+ ADD" Style="{StaticResource ActionButton}"
                    Click="AddDevice_Click" Margin="0,0,4,0"/>
            <Button Grid.Column="2" Content="SCAN" Style="{StaticResource ActionButton}"
                    Click="ScanNetwork_Click"/>
        </Grid>

        <!-- Scan progress -->
        <StackPanel x:Name="ScanProgress" Visibility="Collapsed" Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock x:Name="ScanStatus" Text="Scanning..."
                       Foreground="{StaticResource TextSecondary}"
                       FontFamily="Bahnschrift Light" FontSize="11" VerticalAlignment="Center"/>
            <ProgressBar x:Name="ScanBar" Width="80" Height="3" Margin="8,0,0,0"
                         Background="{StaticResource InactiveColor}"
                         Foreground="{StaticResource AccentColor}"
                         VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Footer: status -->
        <TextBlock x:Name="StatusLabel" Margin="0,6,0,0"
                   Foreground="{StaticResource TextSecondary}"
                   FontFamily="Bahnschrift Light" FontSize="10"
                   Text="No consoles — add an IP above"/>

        <!-- Port filter sections -->
        <Border Margin="0,8,0,0" Background="{StaticResource BackColor}"
                BorderBrush="{StaticResource DividorColor}" BorderThickness="1"
                CornerRadius="5" Padding="10,8">
            <StackPanel>
                <!-- 3074-3173 -->
                <TextBlock Text="3074 — 3173" Foreground="{StaticResource AccentColor}"
                           FontFamily="Bahnschrift Light" FontSize="10" Margin="0,0,0,2"/>
                <Grid MinHeight="28">
                    <Label Content="Enabled" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
                    <controls:Checkbox x:Name="PortToggleCB" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       MouseLeftButtonDown="PortToggle_Click"/>
                </Grid>
                <Grid MinHeight="28">
                    <Label Content="Keybind" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
                    <controls:Button x:Name="PortKeybindBtn" HorizontalAlignment="Right"
                                     Text="No keybind" Click="PortKeybind_Click"/>
                </Grid>

                <!-- Divider -->
                <Border Height="1" Background="{StaticResource DividorColor}" Margin="0,6"/>

                <!-- 7500-7509 -->
                <TextBlock Text="7500 — 7509" Foreground="{StaticResource AccentColor}"
                           FontFamily="Bahnschrift Light" FontSize="10" Margin="0,0,0,2"/>
                <Grid MinHeight="28">
                    <Label Content="Enabled" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
                    <controls:Checkbox x:Name="Port2ToggleCB" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       MouseLeftButtonDown="Port2Toggle_Click"/>
                </Grid>
                <Grid MinHeight="28">
                    <Label Content="Keybind" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
                    <controls:Button x:Name="Port2KeybindBtn" HorizontalAlignment="Right"
                                     Text="No keybind" Click="Port2Keybind_Click"/>
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
