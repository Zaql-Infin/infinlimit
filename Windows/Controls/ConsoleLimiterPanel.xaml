<UserControl x:Class="InfinLimit.Windows.Controls.ConsoleLimiterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:InfinLimit.Controls"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Bahnschrift Light"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,0,0"/>
            <Setter Property="Height" Value="28"/>
        </Style>

        <Style x:Key="DeviceCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LightBackColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividorColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="SpeedBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BackColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividorColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontFamily" Value="Bahnschrift Light"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource LightBackColor}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontFamily" Value="Bahnschrift Light"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#E85D5D"/>
            <Setter Property="BorderBrush" Value="#E85D5D"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Xbox / PlayStation label -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <!-- Controller icon path (D2 gamepad) -->
            <Path Data="M7 6H17C18.6 6 20 7 20.8 8.4L22 11V15C22 16.1 21.1 17 20 17H4C2.9 17 2 16.1 2 15V11L3.2 8.4C4 7 5.4 6 7 6ZM10 10H8V8H6V10H4V12H6V14H8V12H10V10ZM16 9C15.4 9 15 9.4 15 10S15.4 11 16 11 17 10.6 17 10 16.6 9 16 9ZM18 11C17.4 11 17 11.4 17 12S17.4 13 18 13 19 12.6 19 12 18.6 11 18 11Z"
                  Fill="{StaticResource AccentColor}" Stretch="Uniform" Width="16" Height="16"
                  Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Foreground="{StaticResource AccentColor}"
                       FontFamily="Bahnschrift Light" FontSize="13" VerticalAlignment="Center">
                <Run Text="CONSOLE LIMITER"/>
                <Run Text="  ·  " Foreground="{StaticResource TextSecondary}"/>
                <Run Text="XBOX / PLAYSTATION" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
            </TextBlock>
        </StackPanel>

        <!-- Keybind rows (PVE-style) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="28"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Enabled -->
            <Label Grid.Row="0" Grid.Column="0" Content="Enabled" Style="{StaticResource RowLabel}"/>
            <controls:Button Grid.Row="0" Grid.Column="1" x:Name="BindEnabled"
                             Text="No keybind" Click="KeybindButtonClick" HorizontalAlignment="Right"/>
            <controls:Checkbox Grid.Row="0" Grid.Column="2" x:Name="ChkEnabled"
                               Width="22" Height="22" Margin="3,0,0,0"
                               MouseDown="ChkEnabled_Click"/>

            <!-- DL -->
            <Label Grid.Row="1" Grid.Column="0" Content="DL" Style="{StaticResource RowLabel}"/>
            <controls:Button Grid.Row="1" Grid.Column="1" x:Name="BindDL"
                             Text="No keybind" Click="KeybindButtonClick" HorizontalAlignment="Right"/>
            <controls:Checkbox Grid.Row="1" Grid.Column="2" x:Name="ChkDL"
                               Width="22" Height="22" Margin="3,0,0,0"
                               MouseDown="ChkDL_Click"/>

            <!-- UL -->
            <Label Grid.Row="2" Grid.Column="0" Content="UL" Style="{StaticResource RowLabel}"/>
            <controls:Button Grid.Row="2" Grid.Column="1" x:Name="BindUL"
                             Text="No keybind" Click="KeybindButtonClick" HorizontalAlignment="Right"/>
            <controls:Checkbox Grid.Row="2" Grid.Column="2" x:Name="ChkUL"
                               Width="22" Height="22" Margin="3,0,0,0"
                               MouseDown="ChkUL_Click"/>

            <!-- DL Slow -->
            <Label Grid.Row="3" Grid.Column="0" Content="DL Slow" Style="{StaticResource RowLabel}"/>
            <controls:Button Grid.Row="3" Grid.Column="1" x:Name="BindDLSlow"
                             Text="No keybind" Click="KeybindButtonClick" HorizontalAlignment="Right"/>
            <controls:Checkbox Grid.Row="3" Grid.Column="2" x:Name="ChkDLSlow"
                               Width="22" Height="22" Margin="3,0,0,0"
                               MouseDown="ChkDLSlow_Click"/>

            <!-- UL Slow -->
            <Label Grid.Row="4" Grid.Column="0" Content="UL Slow" Style="{StaticResource RowLabel}"/>
            <controls:Button Grid.Row="4" Grid.Column="1" x:Name="BindULSlow"
                             Text="No keybind" Click="KeybindButtonClick" HorizontalAlignment="Right"/>
            <controls:Checkbox Grid.Row="4" Grid.Column="2" x:Name="ChkULSlow"
                               Width="22" Height="22" Margin="3,0,0,0"
                               MouseDown="ChkULSlow_Click"/>

            <!-- Auto-resync -->
            <Label Grid.Row="5" Grid.Column="0" Content="Auto-resync" Style="{StaticResource RowLabel}"/>
            <controls:Button Grid.Row="5" Grid.Column="1" x:Name="BindAutoResync"
                             Text="No keybind" Click="KeybindButtonClick" HorizontalAlignment="Right"/>
            <controls:Checkbox Grid.Row="5" Grid.Column="2" x:Name="ChkAutoResync"
                               Width="22" Height="22" Margin="3,0,0,0"
                               MouseDown="ChkAutoResync_Click"/>

            <!-- Buffering -->
            <Label Grid.Row="6" Grid.Column="0" Content="Buffering" Style="{StaticResource RowLabel}"/>
            <controls:Button Grid.Row="6" Grid.Column="1" x:Name="BindBuffering"
                             Text="No keybind" Click="KeybindButtonClick" HorizontalAlignment="Right"/>
            <controls:Checkbox Grid.Row="6" Grid.Column="2" x:Name="ChkBuffering"
                               Width="22" Height="22" Margin="3,0,0,0"
                               MouseDown="ChkBuffering_Click"/>
        </Grid>

        <!-- Divider -->
        <Line Grid.Row="2" X1="0" X2="1" Stretch="Fill"
              Stroke="{StaticResource DividorColor}" StrokeThickness="1"
              VerticalAlignment="Center" Margin="0,4"/>

        <!-- Add Device Row -->
        <Border Grid.Row="3" Style="{StaticResource DeviceCard}" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="NewDeviceIP" Style="{StaticResource SpeedBox}" Width="Auto"
                             Text="" Margin="0,0,6,0" FontSize="12"
                             ToolTip="Enter Xbox or PlayStation IP (e.g. 192.168.1.50)">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{StaticResource BackColor}"
                                        BorderBrush="{StaticResource DividorColor}"
                                        BorderThickness="1" CornerRadius="4">
                                    <ScrollViewer x:Name="PART_ContentHost" Padding="8,4"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <TextBlock Text="Enter Xbox / PlayStation IP"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="Bahnschrift Light" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=NewDeviceIP}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="1" Content="+ ADD" Style="{StaticResource ActionButton}"
                        Click="AddDevice_Click" Margin="8,0,0,0"/>
                <Button Grid.Column="2" Content="SCAN" Style="{StaticResource ActionButton}"
                        Click="ScanNetwork_Click" Margin="6,0,0,0"/>
            </Grid>
        </Border>

        <!-- Scan progress -->
        <Border Grid.Row="3" x:Name="ScanProgress" Visibility="Collapsed"
                Background="{StaticResource LightBackColor}" CornerRadius="4"
                Padding="10,5" Margin="0,48,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ScanStatus" Text="Scanning..."
                           Foreground="{StaticResource TextSecondary}"
                           FontFamily="Bahnschrift Light" FontSize="11" VerticalAlignment="Center"/>
                <ProgressBar x:Name="ScanBar" Width="100" Height="3" Margin="10,0,0,0"
                             Background="{StaticResource InactiveColor}"
                             Foreground="{StaticResource AccentColor}"
                             VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Device list -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
            <ItemsControl x:Name="DeviceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DeviceCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="Bahnschrift Light" FontSize="13"/>
                                    <TextBlock Text="{Binding IP}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontFamily="Bahnschrift Light" FontSize="10" Margin="0,1,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="UL (Kbps)"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontFamily="Bahnschrift Light" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                    <TextBox Text="{Binding UploadKbps, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SpeedBox}" Width="65"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="DL (Kbps)"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontFamily="Bahnschrift Light" FontSize="10"
                                               HorizontalAlignment="Center"/>
                                    <TextBox Text="{Binding DownloadKbps, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SpeedBox}" Width="65"/>
                                </StackPanel>

                                <!-- D2 diamond status indicator -->
                                <Path Grid.Column="3" Width="8" Height="8" Margin="0,0,10,0"
                                      VerticalAlignment="Center"
                                      Data="M4 0L8 4L4 8L0 4Z" Stretch="Uniform">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{StaticResource InactiveColor}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AccentColor}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>

                                <Button Grid.Column="4" Content="✕" Style="{StaticResource DangerButton}"
                                        Width="24" Padding="0" FontSize="11"
                                        Tag="{Binding}"
                                        Click="RemoveDevice_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="4" x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Path Data="M7 6H17C18.6 6 20 7 20.8 8.4L22 11V15C22 16.1 21.1 17 20 17H4C2.9 17 2 16.1 2 15V11L3.2 8.4C4 7 5.4 6 7 6ZM10 10H8V8H6V10H4V12H6V14H8V12H10V10ZM16 9C15.4 9 15 9.4 15 10S15.4 11 16 11 17 10.6 17 10 16.6 9 16 9ZM18 11C17.4 11 17 11.4 17 12S17.4 13 18 13 19 12.6 19 12 18.6 11 18 11Z"
                  Fill="{StaticResource InactiveColor}" Stretch="Uniform" Width="36" Height="36" Margin="0,0,0,10"/>
            <TextBlock Text="No consoles added"
                       Foreground="{StaticResource TextSecondary}"
                       FontFamily="Bahnschrift Light" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Text="Add an Xbox or PlayStation IP above"
                       Foreground="{StaticResource InactiveColor}"
                       FontFamily="Bahnschrift Light" FontSize="10" HorizontalAlignment="Center"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel" Grid.Column="0"
                       Foreground="{StaticResource TextSecondary}"
                       FontFamily="Bahnschrift Light" FontSize="11"
                       VerticalAlignment="Center" Text="No consoles — add an IP above"/>
            <Button Grid.Column="1" Content="APPLY LIMITS" Style="{StaticResource ActionButton}"
                    Click="ApplyLimits_Click" Padding="12,5"/>
        </Grid>
    </Grid>
</UserControl>
