<UserControl x:Class="InfinLimit.Windows.Controls.ConsoleLimiterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:InfinLimit.Controls"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Bahnschrift Light"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="-6,-5"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <Style x:Key="SpeedBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BackColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividorColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontFamily" Value="Bahnschrift Light"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="65"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource LightBackColor}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontFamily" Value="Bahnschrift Light"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#E85D5D"/>
            <Setter Property="BorderBrush" Value="#E85D5D"/>
        </Style>

        <Style x:Key="DeviceCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BackColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividorColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0" Orientation="Vertical">

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Path Data="M7 6H17C18.6 6 20 7 20.8 8.4L22 11V15C22 16.1 21.1 17 20 17H4C2.9 17 2 16.1 2 15V11L3.2 8.4C4 7 5.4 6 7 6ZM10 10H8V8H6V10H4V12H6V14H8V12H10V10ZM16 9C15.4 9 15 9.4 15 10S15.4 11 16 11 17 10.6 17 10 16.6 9 16 9ZM18 11C17.4 11 17 11.4 17 12S17.4 13 18 13 19 12.6 19 12 18.6 11 18 11Z"
                  Fill="{StaticResource AccentColor}" Stretch="Uniform" Width="14" Height="14"
                  Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Foreground="{StaticResource AccentColor}"
                       FontFamily="Bahnschrift Light" FontSize="12" VerticalAlignment="Center">
                <Run Text="CONSOLE LIMITER"/>
                <Run Text="  ·  " Foreground="{StaticResource TextSecondary}"/>
                <Run Text="XBOX / PLAYSTATION" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
            </TextBlock>
        </StackPanel>

        <!-- Game selector -->
        <Grid Margin="0,0,0,2">
            <Label Content="Game" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
            <ComboBox x:Name="GameSelector" HorizontalAlignment="Right" Width="120"
                      SelectionChanged="GameSelector_Changed"
                      Height="22"
                      Background="{StaticResource BackColor}"
                      Foreground="{StaticResource TextPrimary}"
                      BorderBrush="{StaticResource DividorColor}"
                      BorderThickness="1"
                      FontFamily="Bahnschrift Light"
                      FontSize="11">
                <ComboBox.Resources>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{StaticResource LightBackColor}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="FontFamily" Value="Bahnschrift Light"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="6,3"/>
                    </Style>
                </ComboBox.Resources>
            </ComboBox>
        </Grid>

        <!-- Divider -->
        <Separator Background="{StaticResource DividorColor}" Margin="0,4,0,2" Height="1" Opacity="0.5"/>

        <!-- Keybind rows -->
        <!-- Enabled -->
        <Grid Margin="0,1">
            <Label Content="Enabled" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <controls:Button x:Name="BindEnabled" Text="No keybind" Click="KeybindButtonClick"/>
                <controls:Checkbox x:Name="ChkEnabled" Width="20" Height="20" Margin="6,0,0,0"
                                   VerticalAlignment="Center" MouseDown="ChkEnabled_Click"/>
            </StackPanel>
        </Grid>

        <!-- DL -->
        <Grid Margin="0,1">
            <Label Content="DL" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <controls:Button x:Name="BindDL" Text="No keybind" Click="KeybindButtonClick"/>
                <controls:Checkbox x:Name="ChkDL" Width="20" Height="20" Margin="6,0,0,0"
                                   VerticalAlignment="Center" MouseDown="ChkDL_Click"/>
            </StackPanel>
        </Grid>

        <!-- UL -->
        <Grid Margin="0,1">
            <Label Content="UL" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <controls:Button x:Name="BindUL" Text="No keybind" Click="KeybindButtonClick"/>
                <controls:Checkbox x:Name="ChkUL" Width="20" Height="20" Margin="6,0,0,0"
                                   VerticalAlignment="Center" MouseDown="ChkUL_Click"/>
            </StackPanel>
        </Grid>

        <!-- DL Slow -->
        <Grid Margin="0,1">
            <Label Content="DL Slow" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <controls:Button x:Name="BindDLSlow" Text="No keybind" Click="KeybindButtonClick"/>
                <controls:Checkbox x:Name="ChkDLSlow" Width="20" Height="20" Margin="6,0,0,0"
                                   VerticalAlignment="Center" MouseDown="ChkDLSlow_Click"/>
            </StackPanel>
        </Grid>

        <!-- UL Slow -->
        <Grid Margin="0,1">
            <Label Content="UL Slow" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <controls:Button x:Name="BindULSlow" Text="No keybind" Click="KeybindButtonClick"/>
                <controls:Checkbox x:Name="ChkULSlow" Width="20" Height="20" Margin="6,0,0,0"
                                   VerticalAlignment="Center" MouseDown="ChkULSlow_Click"/>
            </StackPanel>
        </Grid>

        <!-- Auto-resync -->
        <Grid Margin="0,1">
            <Label Content="Auto-resync" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <controls:Button x:Name="BindAutoResync" Text="No keybind" Click="KeybindButtonClick"/>
                <controls:Checkbox x:Name="ChkAutoResync" Width="20" Height="20" Margin="6,0,0,0"
                                   VerticalAlignment="Center" MouseDown="ChkAutoResync_Click"/>
            </StackPanel>
        </Grid>

        <!-- Buffering -->
        <Grid Margin="0,1">
            <Label Content="Buffering" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <controls:Button x:Name="BindBuffering" Text="No keybind" Click="KeybindButtonClick"/>
                <controls:Checkbox x:Name="ChkBuffering" Width="20" Height="20" Margin="6,0,0,0"
                                   VerticalAlignment="Center" MouseDown="ChkBuffering_Click"/>
            </StackPanel>
        </Grid>

        <!-- Divider -->
        <Separator Background="{StaticResource DividorColor}" Margin="0,6,0,4" Height="1" Opacity="0.5"/>

        <!-- Add device row -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BackColor}"
                    BorderBrush="{StaticResource DividorColor}" BorderThickness="1"
                    CornerRadius="4" Margin="0,0,6,0">
                <Grid>
                    <TextBox x:Name="NewDeviceIP" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimary}"
                             FontFamily="Bahnschrift Light" FontSize="11"
                             Padding="6,3" CaretBrush="{StaticResource AccentColor}"
                             ToolTip="Xbox or PlayStation IP (e.g. 192.168.1.50)"/>
                    <TextBlock Text="IP address..." IsHitTestVisible="False"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="Bahnschrift Light" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=NewDeviceIP}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Button Grid.Column="1" Content="+ ADD" Style="{StaticResource ActionButton}"
                    Click="AddDevice_Click" Margin="0,0,4,0"/>
            <Button Grid.Column="2" Content="SCAN" Style="{StaticResource ActionButton}"
                    Click="ScanNetwork_Click"/>
        </Grid>

        <!-- Scan progress -->
        <StackPanel x:Name="ScanProgress" Visibility="Collapsed" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock x:Name="ScanStatus" Text="Scanning..."
                       Foreground="{StaticResource TextSecondary}"
                       FontFamily="Bahnschrift Light" FontSize="11" VerticalAlignment="Center"/>
            <ProgressBar x:Name="ScanBar" Width="80" Height="3" Margin="8,0,0,0"
                         Background="{StaticResource InactiveColor}"
                         Foreground="{StaticResource AccentColor}"
                         VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Device list (scrollable, fixed max height) -->
        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DeviceCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontFamily="Bahnschrift Light" FontSize="12"/>
                                        <TextBlock Text="{Binding IP}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontFamily="Bahnschrift Light" FontSize="10"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="8,0" VerticalAlignment="Center">
                                        <TextBlock Text="UL" Foreground="{StaticResource TextSecondary}"
                                                   FontFamily="Bahnschrift Light" FontSize="9"
                                                   HorizontalAlignment="Center"/>
                                        <TextBox Text="{Binding UploadKbps, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SpeedBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="DL" Foreground="{StaticResource TextSecondary}"
                                                   FontFamily="Bahnschrift Light" FontSize="9"
                                                   HorizontalAlignment="Center"/>
                                        <TextBox Text="{Binding DownloadKbps, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SpeedBox}"/>
                                    </StackPanel>

                                    <!-- D2 diamond active indicator -->
                                    <Path Grid.Column="3" Width="7" Height="7" Margin="0,0,8,0"
                                          VerticalAlignment="Center" Data="M3.5 0L7 3.5L3.5 7L0 3.5Z" Stretch="Uniform">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{StaticResource InactiveColor}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentColor}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>

                                    <Button Grid.Column="4" Content="✕" Style="{StaticResource DangerButton}"
                                            Width="22" Height="22" Padding="0" FontSize="10"
                                            Tag="{Binding}" Click="RemoveDevice_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" Margin="0,12,0,8">
                    <Path Data="M7 6H17C18.6 6 20 7 20.8 8.4L22 11V15C22 16.1 21.1 17 20 17H4C2.9 17 2 16.1 2 15V11L3.2 8.4C4 7 5.4 6 7 6ZM10 10H8V8H6V10H4V12H6V14H8V12H10V10ZM16 9C15.4 9 15 9.4 15 10S15.4 11 16 11 17 10.6 17 10 16.6 9 16 9ZM18 11C17.4 11 17 11.4 17 12S17.4 13 18 13 19 12.6 19 12 18.6 11 18 11Z"
                          Fill="{StaticResource InactiveColor}" Stretch="Uniform"
                          Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="No consoles added" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="Bahnschrift Light" FontSize="11"/>
                    <TextBlock Text="Add an Xbox or PlayStation IP above" HorizontalAlignment="Center"
                               Foreground="{StaticResource InactiveColor}"
                               FontFamily="Bahnschrift Light" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Margin="0,6,0,0">
            <TextBlock x:Name="StatusLabel" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"
                       FontFamily="Bahnschrift Light" FontSize="10"
                       Text="No consoles — add an IP above"/>
            <Button HorizontalAlignment="Right" Content="APPLY LIMITS"
                    Style="{StaticResource ActionButton}" Click="ApplyLimits_Click"/>
        </Grid>

    </StackPanel>
</UserControl>
