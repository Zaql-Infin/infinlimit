<UserControl x:Class="InfinLimit.Windows.Controls.ConsoleLimiterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Device card style -->
        <Style x:Key="DeviceCard" TargetType="Border">
            <Setter Property="Background" Value="#0E1622"/>
            <Setter Property="BorderBrush" Value="#1A2540"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7FA3"/>
            <Setter Property="FontFamily" Value="Bahnschrift Light"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8F0FF"/>
            <Setter Property="FontFamily" Value="Bahnschrift Light"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SpeedBox" TargetType="TextBox">
            <Setter Property="Background" Value="#080C14"/>
            <Setter Property="Foreground" Value="#E8F0FF"/>
            <Setter Property="BorderBrush" Value="#1A2540"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontFamily" Value="Bahnschrift Light"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#00D4FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0E1622"/>
            <Setter Property="Foreground" Value="#00D4FF"/>
            <Setter Property="BorderBrush" Value="#00D4FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontFamily" Value="Bahnschrift Light"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0A1828"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#001833"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="BorderBrush" Value="#FF6B6B"/>
        </Style>

        <Style x:Key="ToggleOnOff" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="10" Background="#1A2540"/>
                            <Ellipse x:Name="Thumb" Width="14" Height="14"
                                     Fill="#6B7FA3" HorizontalAlignment="Left"
                                     Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#004466"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#00D4FF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Path Data="M21 6H3C1.9 6 1 6.9 1 8V16C1 17.1 1.9 18 3 18H21C22.1 18 23 17.1 23 16V8C23 6.9 22.1 6 21 6M11 13H8V16H6V13H3V11H6V8H8V11H11M15.5 15C14.7 15 14 14.3 14 13.5S14.7 12 15.5 12 17 12.7 17 13.5 16.3 15 15.5 15M19.5 12C18.7 12 18 11.3 18 10.5S18.7 9 19.5 9 21 9.7 21 10.5 20.3 12 19.5 12Z"
                  Fill="#00D4FF" Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="CONSOLE  LIMITER" Foreground="#00D4FF"
                       FontFamily="Bahnschrift Light" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Add Device Row -->
        <Border Grid.Row="1" Style="{StaticResource DeviceCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewDeviceIP" Grid.Column="0"
                             Style="{StaticResource SpeedBox}" Width="Auto"
                             Text="" Margin="0,0,6,0"
                             FontSize="12"
                             ToolTip="Enter console IP address (e.g. 192.168.1.50)">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="#080C14" BorderBrush="#1A2540"
                                        BorderThickness="1" CornerRadius="5">
                                    <ScrollViewer x:Name="PART_ContentHost" Padding="8,4"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <TextBlock Grid.Column="0" Text="192.168.x.x — enter console IP"
                               Foreground="#3A4A6A" FontFamily="Bahnschrift Light" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=NewDeviceIP}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="1" Content="+ ADD DEVICE" Style="{StaticResource ActionButton}"
                        Click="AddDevice_Click" Margin="8,0,0,0"/>
                <Button Grid.Column="2" Content="SCAN NETWORK" Style="{StaticResource ActionButton}"
                        Click="ScanNetwork_Click" Margin="6,0,0,0"/>
            </Grid>
        </Border>

        <!-- Scan progress -->
        <Border Grid.Row="1" x:Name="ScanProgress" Visibility="Collapsed"
                Background="#0A1220" CornerRadius="6" Padding="10,6" Margin="0,70,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ScanStatus" Text="Scanning..." Foreground="#6B7FA3"
                           FontFamily="Bahnschrift Light" FontSize="11" VerticalAlignment="Center"/>
                <ProgressBar x:Name="ScanBar" Width="120" Height="4" Margin="10,0,0,0"
                             Background="#1A2540" Foreground="#00D4FF" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Device List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DeviceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DeviceCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Device icon + IP -->
                                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ValueLabel}"/>
                                    <TextBlock Text="{Binding IP}" Style="{StaticResource HeaderLabel}" Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- Upload limit -->
                                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="UL (Kbps)" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center"/>
                                    <TextBox Text="{Binding UploadKbps, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SpeedBox}" Width="65"/>
                                </StackPanel>

                                <!-- Download limit -->
                                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="DL (Kbps)" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center"/>
                                    <TextBox Text="{Binding DownloadKbps, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SpeedBox}" Width="65"/>
                                </StackPanel>

                                <!-- Status indicator -->
                                <Ellipse Grid.Column="3" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#1A2540"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                    <Setter Property="Fill" Value="#00D4FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <!-- Toggle -->
                                <ToggleButton Grid.Column="4" Style="{StaticResource ToggleOnOff}"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              Margin="0,0,10,0"/>

                                <!-- Remove -->
                                <Button Grid.Column="5" Content="✕" Style="{StaticResource DangerButton}"
                                        Width="26" Padding="0" FontSize="12"
                                        Tag="{Binding}"
                                        Click="RemoveDevice_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="2" x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Path Data="M21 6H3C1.9 6 1 6.9 1 8V16C1 17.1 1.9 18 3 18H21C22.1 18 23 17.1 23 16V8C23 6.9 22.1 6 21 6M11 13H8V16H6V13H3V11H6V8H8V11H11M15.5 15C14.7 15 14 14.3 14 13.5S14.7 12 15.5 12 17 12.7 17 13.5 16.3 15 15.5 15M19.5 12C18.7 12 18 11.3 18 10.5S18.7 9 19.5 9 21 9.7 21 10.5 20.3 12 19.5 12Z"
                  Fill="#1A2540" Stretch="Uniform" Width="40" Height="40" Margin="0,0,0,12"/>
            <TextBlock Text="No devices added" Foreground="#3A4A6A"
                       FontFamily="Bahnschrift Light" FontSize="13" HorizontalAlignment="Center"/>
            <TextBlock Text="Add a console IP above or scan your network" Foreground="#2A3A5A"
                       FontFamily="Bahnschrift Light" FontSize="11" HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Footer - Apply button -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel" Grid.Column="0"
                       Foreground="#3A4A6A" FontFamily="Bahnschrift Light" FontSize="11"
                       VerticalAlignment="Center" Text="0 devices — limits inactive"/>
            <Button Grid.Column="1" Content="APPLY LIMITS" Style="{StaticResource ActionButton}"
                    Click="ApplyLimits_Click" Padding="14,6"/>
        </Grid>
    </Grid>
</UserControl>
