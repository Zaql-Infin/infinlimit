<UserControl x:Class="InfinLimit.Controls.Checkbox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="18" d:DesignWidth="18"
             Focusable="False" IsHitTestVisible="True"
             Width="18" Height="18">
    <Grid Cursor="Hand">
        <!-- Box -->
        <Border x:Name="Track"
                CornerRadius="4"
                Background="{StaticResource InactiveColor}"
                MouseEnter="Track_MouseEnter"
                MouseLeave="Track_MouseLeave"
                MouseDown="Track_MouseDown"/>

        <!-- Checkmark -->
        <Path x:Name="Thumb"
              Data="M4 9 L7 13 L14 5"
              Stroke="White"
              StrokeThickness="2"
              StrokeLineJoin="Round"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              IsHitTestVisible="False"
              Opacity="0"/>
    </Grid>
</UserControl>
