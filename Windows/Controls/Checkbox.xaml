<UserControl x:Class="InfinLimit.Controls.Checkbox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="18" d:DesignWidth="34"
             Focusable="False" IsHitTestVisible="True"
             Width="34" Height="18">
    <Grid Cursor="Hand">
        <!-- Track -->
        <Border x:Name="Track"
                CornerRadius="9"
                Background="{StaticResource InactiveColor}"
                MouseEnter="Track_MouseEnter"
                MouseLeave="Track_MouseLeave"
                MouseDown="Track_MouseDown"/>

        <!-- Thumb -->
        <Ellipse x:Name="Thumb"
                 Width="14" Height="14"
                 Fill="White"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 Margin="2,0,0,0"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" Opacity="0.3"/>
            </Ellipse.Effect>
        </Ellipse>
    </Grid>
</UserControl>
